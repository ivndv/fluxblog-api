{
  "name": "blog-personal-fluxdev-backend",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3050",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3050",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "^10.1.0",
    "dotenv": "18.0.9",
    "graphql": "^16.14.2",
    "next": "15.4.11",
    "payload": "3.92.1",
    "payload-oapi": "^0.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.4.11",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
